    {
        "id": "35e2b1d9121eb6b7",
        "type": "function",
        "z": "512ea392e2d7d6d7",
        "name": "Evaluate Motor Condition",
        "func": "\n// Read the incoming sensor value\nconst value = Number(msg.payload);\n\n// Ignore invalid values\nif (!Number.isFinite(value)) {\n    return null;\n}\n\n// Identify the sensor using the NEW EMQX topics\nif (msg.topic.endsWith(\"/temperature\")) {\n    context.set(\"temperature\", value);\n}\nelse if (msg.topic.endsWith(\"/vibration\")) {\n    context.set(\"vibration\", value);\n}\nelse {\n    return null;\n}\n\n// Retrieve the latest sensor values\nconst temperature = context.get(\"temperature\");\nconst vibration = context.get(\"vibration\");\n\n// Wait until both sensors have sent data\nif (temperature === undefined || vibration === undefined) {\n    return null;\n}\n\n// Evaluate motor condition\nlet alert;\n\nif (temperature >= 40 && vibration >= 4) {\n    alert = \"CRITICAL ALERT: HIGH TEMPERATURE AND VIBRATION\";\n}\nelse if (temperature >= 40) {\n    alert = \"WARNING: HIGH TEMPERATURE\";\n}\nelse if (vibration >= 4) {\n    alert = \"WARNING: HIGH VIBRATION\";\n}\nelse {\n    alert = \"NORMAL\";\n}\n\n// Prepare dashboard message\nmsg.payload = alert;\nmsg.temperature = temperature;\nmsg.vibration = vibration;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
        "y": 100,
        "wires": [
