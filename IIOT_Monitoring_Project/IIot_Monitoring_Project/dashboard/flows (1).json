    {
        "id": "50d9721264dd849f",
        "type": "function",
        "z": "512ea392e2d7d6d7",
        "name": "Prepare History Log",
        "func": "\n// Generate timestamp\nconst timestamp = new Date().toISOString();\n\nconst raw = msg.payload;\n\nlet type;\nlet value;\nlet temperature = \"\";\nlet vibration = \"\";\nlet ledStatus = \"\";\n\n// 1. Detect motor alerts\nif (typeof raw === \"string\" &&\n    /^(NORMAL|WARNING:|CRITICAL ALERT:)/.test(raw.trim())) {\n\n    type = \"ALERT\";\n    value = raw.trim();\n\n    temperature = msg.temperature ?? \"\";\n    vibration = msg.vibration ?? \"\";\n\n}\n\n// 2. Detect temperature measurements\nelse if (msg.topic?.endsWith(\"/temperature\")) {\n\n    const number = Number(raw);\n\n    if (!Number.isFinite(number)) return null;\n\n    type = \"TEMPERATURE\";\n    value = number;\n    temperature = number;\n\n}\n\n// 3. Detect vibration measurements\nelse if (msg.topic?.endsWith(\"/vibration\")) {\n\n    const number = Number(raw);\n\n    if (!Number.isFinite(number)) return null;\n\n    type = \"VIBRATION\";\n    value = number;\n    vibration = number;\n\n}\n\n// 4. Detect LED ON/OFF commands\nelse if (typeof raw === \"string\" &&\n         [\"ON\", \"OFF\"].includes(raw.trim().toUpperCase())) {\n\n    type = \"LED\";\n    value = raw.trim().toUpperCase();\n    ledStatus = value;\n\n}\n\n// Ignore unknown messages\nelse {\n    return null;\n}\n\n// Prepare CSV fields safely\nfunction csv(field) {\n    return '\"' + String(field).replace(/\"/g, '\"\"') + '\"';\n}\n\n// Generate CSV row\nmsg.payload = [\n    timestamp,\n    type,\n    value,\n    temperature,\n    vibration,\n    ledStatus\n].map(csv).join(\",\");\n\nreturn msg;\n",
