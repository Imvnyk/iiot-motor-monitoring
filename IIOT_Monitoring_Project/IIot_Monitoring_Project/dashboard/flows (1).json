        "name": "Automatic LED Command",
        "func": "const alert = String(msg.payload);\n\nif (alert.includes(\"WARNING\") ||\n    alert.includes(\"CRITICAL\")) {\n\n    msg.payload = \"ON\";\n\n} else if (alert === \"NORMAL\") {\n\n    msg.payload = \"OFF\";\n\n} else {\n    return null;\n}\n\nreturn msg;",
